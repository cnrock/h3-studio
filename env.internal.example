# ============================================================
# H3 Studio 配置（版本一：内网运行，不需要域名）
# 复制为 .env 后按需修改
# ============================================================

# 部署形态标识（仅用于 /api/health 展示）
DEPLOYMENT=internal

# 网站监听端口
PORT=8787

# 公开访问地址（内网就填本机 IP:端口，用于激活/重置邮件里的链接）
# 例：http://192.0.2.10:8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# ---- MiniMax H3 后端 ----
# 可选：ref2va 专用后端（serve Ref2VA 分区的进程；留空则不启用多后端路由）
H3_BASE_URL_REF2VA=
H3_BASE_URL=http://192.0.2.10:8003
H3_API_KEY=
# 同步接口阻塞等待时长（毫秒），默认 30 分钟
H3_TIMEOUT_MS=1800000

# ---- 会话 ----
JWT_SECRET=请改成一段足够长的随机字符串
JWT_EXPIRES_IN=30d

# ---- 注册与邮箱 ----
# true = 注册后免邮件激活，直接可登录（内网最省事）
SKIP_EMAIL_VERIFICATION=false
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=no-reply@example.com
SMTP_PASS=你的SMTP授权密码
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=H3 Studio
# 若邮件服务器证书与主机名不匹配（如 smtp.example.com 的自签/不匹配证书），设为 false
SMTP_TLS_REJECT_UNAUTHORIZED=false

# ---- 上传限制 ----
MAX_IMAGE_MB=30
MAX_VIDEO_MB=50
MAX_FILES=9
PROMPT_CHARS=20000

# 单次任务允许的总时长（秒）。H3 单段上限 15 秒，超出自动分段续写。默认 1800（30 分钟）。
MAX_DURATION_SEC=1800

# ref2va 参考视频单个时长上限（秒）。H3 硬校验为 2–15 秒，超长会自动截取。
MAX_REF_VIDEO_SEC=15

# 详细日志（分段时长/返回视频与音频时长/拼接结果）。排查长视频音画问题时设 1。
H3_DEBUG=0

# 计费开关：off=不计费只统计（默认）；second=按【秒】计费；job=按【条】计费。
# 未设时按费率推断：CREDITS_PER_JOB>0 用 job，CREDITS_PER_SECOND>0 用 second。
CREDITS_MODE=off
# 按秒计费费率：生成 1 秒扣多少点（可小数）。仅 CREDITS_MODE=second 生效。
CREDITS_PER_SECOND=0
# 按条计费：每完成一条视频扣多少点（可小数）。仅 CREDITS_MODE=job 生效。
CREDITS_PER_JOB=0
