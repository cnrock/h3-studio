# ============================================================
# H3 Studio 配置（版本一：内网运行，不需要域名）
# 复制为 .env 后按需修改
# ============================================================

# 部署形态标识（仅用于 /api/health 展示）
DEPLOYMENT=internal

# 网站监听端口
PORT=8787

# 公开访问地址（内网就填本机 IP:端口，用于激活/重置邮件里的链接）
# 例：http://10.1.10.34:8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# 时区（日志时间戳按此显示）
TZ=Asia/Shanghai

# ---- MiniMax H3 后端 ----
# 可选：ref2va 专用后端（serve Ref2VA 分区的进程；留空则不启用多后端路由）
H3_BASE_URL_REF2VA=
H3_BASE_URL=http://10.1.10.34:32206
H3_API_KEY=
# 同步接口阻塞等待时长（毫秒），默认 30 分钟
H3_TIMEOUT_MS=1800000

# ---- 会话 ----
JWT_SECRET=请改成一段足够长的随机字符串
JWT_EXPIRES_IN=30d

# ---- 注册与邮箱 ----
# true = 注册后免邮件激活，直接可登录（内网最省事）
SKIP_EMAIL_VERIFICATION=false
SMTP_HOST=smtp.88.com
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=model7@88.com
SMTP_PASS=你的SMTP授权密码
SMTP_FROM=model7@88.com
SMTP_FROM_NAME=H3 Studio
# 若邮件服务器证书与主机名不匹配（如 smtp.88.com 的自签/不匹配证书），设为 false
SMTP_TLS_REJECT_UNAUTHORIZED=false

# ---- 上传限制 ----
MAX_IMAGE_MB=30
MAX_VIDEO_MB=50
MAX_FILES=9
PROMPT_CHARS=20000

# 项目级风格记忆字符上限（v1.10）。生成/AI 重写时作为固定前缀注入。
STYLE_MEMORY_CHARS=2000

# 单次任务允许的总时长（秒）。H3 单段上限 15 秒，超出自动分段续写。默认 1800（30 分钟）。
MAX_DURATION_SEC=1800

# ref2va 参考视频单个时长上限（秒）。H3 硬校验为 2–15 秒，超长会自动截取。
MAX_REF_VIDEO_SEC=15

# 详细日志（分段时长/返回视频与音频时长/拼接结果）。排查长视频音画问题时设 1。
H3_DEBUG=0

# H3 引擎瞬时不可用（Stage-0 无可用副本/引擎崩溃后重启）的自动重试。
# 秒级失败（< H3_ENGINE_FAST_FAIL_MS）自动等待重试；长跑中途崩溃不自动重试（避免重复烧算力）。一般无需设置。
H3_ENGINE_RETRY=8
H3_ENGINE_RETRY_WAIT_MS=15000
H3_ENGINE_FAST_FAIL_MS=60000

# 出片自检（v1.11.1）：成片落盘后自动跑音画时长/静音/削波/冻帧检查，结果附在任务里。只提示不拦截；设 0 关闭。
QA_CHECK=1

# 日志级别：debug | info（默认，看请求/任务/分段）| warn | error | silent。
# 默认 info 即可在 docker logs 里看到每个请求与每个生成任务；H3_DEBUG=1 等价于 debug。
LOG_LEVEL=info

# 计费开关：off=不计费只统计（默认）；second=按【秒】计费；job=按【条】计费。
# 未设时按费率推断：CREDITS_PER_JOB>0 用 job，CREDITS_PER_SECOND>0 用 second。
CREDITS_MODE=off
# 按秒计费费率：生成 1 秒扣多少点（可小数）。仅 CREDITS_MODE=second 生效。
CREDITS_PER_SECOND=0
# 按条计费：每完成一条视频扣多少点（可小数）。仅 CREDITS_MODE=job 生效。
CREDITS_PER_JOB=0

# ---- 提示词助手（v1.9）----
# 任一 OpenAI 兼容端点即可（本地 vLLM / 网关 / 云端）。留空则隐藏「AI 重写/描述素材」按钮。
# 密钥只从环境变量读入，不落盘、不回显。
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEXT_MODEL=
LLM_VISION_MODEL=
LLM_TIMEOUT_MS=300000
LLM_MAX_IMAGE_BYTES=8388608
