# ============================================================
# H3 Studio 配置（版本三：公网 VPS 运行）
# 复制为 .env 后按需修改
# ============================================================

DEPLOYMENT=vps

# 本机监听端口（Nginx 反代到这里，建议只监听 127.0.0.1）
PORT=8787
HOST=127.0.0.1

# 公网访问地址（务必是 https，用于邮件里的激活/重置链接）
PUBLIC_BASE_URL=https://your-domain.com

# ---- MiniMax H3 后端（公网接口）----
# 到时会提供公网视频生成接口；这里填公网地址
# 可选：ref2va 专用后端（serve Ref2VA 分区的进程；留空则不启用多后端路由）
H3_BASE_URL_REF2VA=
H3_BASE_URL=https://your-h3-public-endpoint.example.com
H3_API_KEY=如果公网接口需要鉴权就填
H3_TIMEOUT_MS=1800000

# ---- 会话（公网务必换成长随机串）----
JWT_SECRET=请改成一段足够长的随机字符串
JWT_EXPIRES_IN=30d

# ---- 注册与邮箱 ----
SKIP_EMAIL_VERIFICATION=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_USER=no-reply@example.com
SMTP_PASS=你的SMTP授权密码
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=H3 Studio
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ---- 上传限制 ----
MAX_IMAGE_MB=30
MAX_VIDEO_MB=50
MAX_FILES=9
PROMPT_CHARS=20000

# 单次任务允许的总时长（秒）。H3 单段上限 15 秒，超出自动分段续写。默认 1800（30 分钟）。
MAX_DURATION_SEC=1800

# 公网部署建议：
#  - 用 Nginx 反代 + Let's Encrypt HTTPS
#  - 网站只监听 127.0.0.1，由 Nginx 对外
#  - 设置 client_max_body_size ≥ 64m（见 deploy/nginx.conf）

# ref2va 参考视频单个时长上限（秒）。H3 硬校验为 2–15 秒，超长会自动截取。
MAX_REF_VIDEO_SEC=15

# 详细日志（分段时长/返回视频与音频时长/拼接结果）。排查长视频音画问题时设 1。
H3_DEBUG=0
