# ============================================================
# H3 Studio 配置（版本二：Docker 运行）
# 复制为 .env 后按需修改；docker compose 会自动读取
# ============================================================

DEPLOYMENT=docker

PORT=8787

# 宿主机访问地址（浏览器打开的地址，用于邮件里的激活/重置链接）
PUBLIC_BASE_URL=http://127.0.0.1:8787

# ---- MiniMax H3 后端 ----
# Docker 容器内要访问宿主机/内网的自建 H3：
#  - 若 H3 在宿主机上：用 host.docker.internal（compose 已加 host-gateway）
#  - 若 H3 在同一内网另一台机：直接写内网 IP
H3_BASE_URL=http://192.0.2.10:8003
H3_API_KEY=
H3_TIMEOUT_MS=1800000

# ---- 会话 ----
JWT_SECRET=请改成一段足够长的随机字符串
JWT_EXPIRES_IN=30d

# ---- 注册与邮箱 ----
SKIP_EMAIL_VERIFICATION=false
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=no-reply@example.com
SMTP_PASS=你的SMTP授权密码
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=H3 Studio
SMTP_TLS_REJECT_UNAUTHORIZED=false

# ---- 上传限制 ----
MAX_IMAGE_MB=30
MAX_VIDEO_MB=50
MAX_FILES=9
PROMPT_CHARS=7000
